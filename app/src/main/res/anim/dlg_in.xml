<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized_decel">
    <alpha android:duration="@integer/motion_short" android:fromAlpha="0" android:toAlpha="1" />
    <scale
        android:duration="@integer/motion_base"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
