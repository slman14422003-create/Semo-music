<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FEATURE ADDED ("حسن عمل التطبيق في الخلفية بشكل مخفي"): lets the app
         ask the OS, once, to stop freezing its WorkManager jobs
         (BackgroundSyncWorker / NoteReminderWorker) when it decides the app
         is "idle" - see BatteryOptimizationHelper for the one-time,
         no-nagging prompt this enables. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app self-update (Settings → التحديثات): lets the system
         installer be launched directly from this app for the APK it just
         downloaded itself, instead of sending the person to an external
         browser/file manager. On API 26+ the person still has to flip a
         one-time "السماح من هذا المصدر" toggle for this app specifically
         (see ApkDownloader.canInstallPackages) — this permission alone
         doesn't silently install anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- المزامنة الفورية بالخلفية (RealtimeSyncService): خدمة أمامية من نوع
         specialUse تُبقي مستمعات Firestore حيّة والتطبيق مغلق، وBootReceiver
         يعيد تشغيلها بعد إعادة تشغيل الجهاز أو تحديث التطبيق. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- FEATURE ADDED (تحميل التحديث بالخلفية، UpdateDownloadService): مطلوبة
         على أندرويد 14+ (API 34) لأي خدمة أمامية بنوع dataSync — وهو النوع
         الصحيح هنا لأنه تحميل ملف فعلي، بعكس specialUse أعلاه المخصص
         لمزامنة Firestore. بدونها ترفض الأنظمة الحديثة بدء الخدمة أصلاً. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      FEATURE ADDED (package visibility, Android 11+/API 30+): declares the
      two implicit ACTION_VIEW intents this app ever fires at another app —
      installing the self-downloaded update APK (ApkDownloader.install) and
      handing off an external http/https link tapped inside the help/
      privacy in-app browser (WebViewScreen) to the system browser. Both
      targets (the package installer, the default browser) are already on
      Android's own automatic-visibility allowlist and worked without this
      even before — this makes that visibility explicit and future-proof
      instead of silently depending on an OS default that could vary by
      OEM/ROM, and is the pattern Play Console itself recommends for an
      app that installs its own updates.
    -->
    <!-- FEATURE ADDED (توافق أوسع مع الأجهزة، لا يؤثر على الهواتف): يصرّح
         صراحة أن التطبيق لا يحتاج شاشة لمس فعلياً — بدونها يستبعد متجر Play
         تلقائياً أي جهاز بلا لمس (كروم بوك، بعض التابلت مع فأرة/لوحة مفاتيح
         فقط) من رؤية التطبيق أصلاً، رغم أن واجهته تعمل بشكل طبيعي بالنقر. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
      enableOnBackInvokedCallback="false" (تحت): نظام الـpredictive-back الخاص
      بالنظام مُطفأ عمداً. لو كان مفعّلاً لعرض أندرويد معاينته الافتراضية فوق
      أي سحبة من الحافة بدل حركة الرجوع المنسّقة في MainActivity
      (`popEnterTransition`/`popExitTransition` = عكس حركة الدخول تماماً)،
      فيصير الرجوع (سحبة أو زر) دائماً بحركة واحدة ثابتة.
    -->
    <application
        android:name=".ShopManagerApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopManager"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="false">

        <!--
          FEATURE ADDED (privacy — ties directly into "سياسة الخصوصية": "لا
          يحتوي على إعلانات أو أدوات تتبع"): WebView itself can otherwise
          collect and send anonymous usage metrics for every WebView in the
          app, independent of anything the app's own code does — this is
          the documented AndroidX/AOSP switch to opt every WebView instance
          (the help/privacy pages) out of that collection app-wide.
        -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!--
          PERF FIX (startup jitter): androidx.work auto-registers a
          ContentProvider (WorkManagerInitializer) that runs before
          Application.onCreate on EVERY cold start, unconditionally, the
          moment the work-runtime-ktx dependency exists in the app —
          whether or not a worker is ever scheduled yet. That provider
          builds WorkManager's Room database on the spot, on the main
          thread. On a fast phone that's invisible; on a slow eMMC/2GB
          device it's real main-thread time competing with the very
          first Compose frames — exactly what shows up as the app
          "shaking" for the first couple of seconds. Removing this
          default initializer moves that same setup to run lazily
          instead (see ShopManagerApplication + MainActivity, where it
          now happens off the main thread, after the splash screen is
          already covering the UI).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Used by MaterialsReportImage to share the generated PNG report
          image (see the "مشاركة" button on the materials screen) - lets
          the share-sheet target app read the file from our cache dir
          without exposing any other app storage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          "إشعارات أكثر تطورًا وكفاءة": يستقبل أزرار الإجراءات الملحقة
          بإشعارات NotificationHelper (تأجيل تذكير، تجاهل قائمة المشتريات)
          وينفّذها مباشرة دون فتح التطبيق. exported="false" لأن كل
          PendingIntent موجّه لهذا المستقبل يُبنى داخل التطبيق نفسه (انظر
          NotificationHelper.buildActionIntent) — لا شيء خارجي يستطيع
          استدعاءه.
        -->
        <receiver
            android:name=".data.notifications.NotificationActionReceiver"
            android:exported="false" />

        <!--
          المزامنة الفورية: خدمة أمامية تُبقي اتصال Firestore حيّاً فيصل إشعار
          الديون/المواد/الملاحظات لحظة حدوثه حتى والتطبيق مغلق (WorkManager وحده
          يتأجّل ساعات بسبب Doze وحماية البطارية). specialUse بلا مهلة 6 ساعات
          الخاصة بـ dataSync على أندرويد 15+. للمستخدم مفتاح لإيقافها من الإعدادات.
        -->
        <service
            android:name=".data.notifications.RealtimeSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a Firestore listener alive to deliver shop debt, stock and note notifications from other devices in real time" />
        </service>

        <!--
          FEATURE ADDED ("والتحميل يكون في الخلفية"): خدمة أمامية من نوع
          dataSync تُنزّل ملف APK التحديث بنفسها — انظر UpdateDownloadService
          وUpdateDownloadState لسبب نقل هذا من كود Compose (كان يتوقف فور
          مغادرة الشاشة) إلى هنا. exported="false" لأنها تُشغَّل فقط من
          داخل التطبيق نفسه (UpdateDownloadService.start).
        -->
        <service
            android:name=".data.updates.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- يعيد تشغيل الخدمة بعد الإقلاع/تحديث التطبيق. بثّان محميان من النظام. -->
        <receiver
            android:name=".data.notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ShopManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.ShopWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shop_widget_info" />
        </receiver>
    </application>
</manifest>
